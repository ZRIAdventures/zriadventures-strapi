# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS=key1,key2,key3,key4

# Admin panel auth (no fallback - Strapi will fail to start without this)
ADMIN_JWT_SECRET=
API_TOKEN_SALT=

# Users & Permissions plugin (content API JWTs)
JWT_SECRET=

# Postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=strapi
PGUSER=strapi
PGPASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Cloudinary (media upload provider)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Redis (optional - set REDIS_ENABLED=false to disable)
REDIS_ENABLED=true
REDIS_URL=
REDIS_DB=0
REDIS_DEBUG=false
REDIS_ENABLE_REDLOCK=false

# zriadventures-web sync (v2-order payment status webhook)
APP_BASE_URL=
INTERNAL_API_SECRET=
